{
  "schema_version": "1",
  "identity": {
    "publisher_id": "io.piphi",
    "package_id": "octopus-rates",
    "version": "0.1.1"
  },
  "name": "Octopus Tariff Rates",
  "description": "Current and upcoming VAT-inclusive electricity unit rates from the configured public Octopus tariff.",
  "origin": "integration",
  "owning_integration_id": "piphi-network-octopus-energy",
  "sdk_version_range": ">=0.6.1,<0.7",
  "requires_integrations": [
    {
      "integration_id": "piphi-network-octopus-energy",
      "version_range": ">=0.1,<1",
      "optional": false
    }
  ],
  "recommended_for_integrations": [
    "piphi-network-octopus-energy"
  ],
  "widgets": [
    {
      "id": "electricity-rates",
      "name": "Electricity Rates",
      "description": "Current and next pence-per-kWh prices for one configured tariff.",
      "runtime": "declarative",
      "presentation": {
        "contract_version": "1",
        "shell": "core",
        "content_surface": "transparent",
        "typography": "core",
        "appearance_controls": [
          "icon",
          "title",
          "surface",
          "opacity",
          "radius",
          "shadow"
        ]
      },
      "interaction_targets": [
        {
          "id": "card",
          "label": "Octopus tariff",
          "kind": "card",
          "allowed_actions": [
            "more-info",
            "popout",
            "refresh"
          ],
          "default_action": "more-info"
        },
        {
          "id": "current",
          "label": "Current rate",
          "kind": "binding",
          "binding_slot_id": "current",
          "allowed_actions": [
            "more-info",
            "history",
            "popout"
          ],
          "default_action": "more-info"
        },
        {
          "id": "next",
          "label": "Next rate",
          "kind": "binding",
          "binding_slot_id": "next",
          "allowed_actions": [
            "more-info",
            "history",
            "popout"
          ],
          "default_action": "more-info"
        }
      ],
      "binding_slots": [
        {
          "id": "current",
          "label": "Current rate",
          "required": true,
          "binding_modes": [
            "read"
          ],
          "capability_requirements": [
            "current_rate"
          ],
          "compatible_integration_ids": [
            "piphi-network-octopus-energy"
          ],
          "data_delivery": {"mode": "stream_preferred", "stale_after_seconds": 600}
        },
        {
          "id": "next",
          "label": "Next rate",
          "required": false,
          "binding_modes": [
            "read"
          ],
          "capability_requirements": [
            "next_rate"
          ],
          "compatible_integration_ids": [
            "piphi-network-octopus-energy"
          ],
          "data_delivery": {"mode": "stream_preferred", "stale_after_seconds": 600}
        }
      ],
      "recipe": {
        "schema_version": "1",
        "layout": "grid",
        "columns": 2,
        "items": [
          {
            "type": "metric",
            "slot_id": "current",
            "label": "Now · p/kWh",
            "format": "number",
            "domain": "energy",
            "emphasis": "hero",
            "action": {
              "type": "details",
              "label": "View current rate details"
            }
          },
          {
            "type": "metric",
            "slot_id": "next",
            "label": "Next · p/kWh",
            "format": "number",
            "domain": "energy",
            "action": {
              "type": "details",
              "label": "View upcoming rate details"
            }
          }
        ]
      },
      "certification": {
        "schema_version": "1",
        "verified_gates": ["runtime", "persistence", "binding", "states", "responsive", "themes", "accessibility", "save-reload", "performance"],
        "evidence": {
          "runtime": ["core-profile:declarative-v2/runtime"],
          "persistence": ["core-profile:declarative-v2/persistence"],
          "binding": ["core-profile:declarative-v2/binding"],
          "states": ["core-profile:declarative-v2/states"],
          "responsive": ["core-profile:declarative-v2/responsive"],
          "themes": ["core-profile:declarative-v2/themes"],
          "accessibility": ["core-profile:declarative-v2/accessibility"],
          "save-reload": ["core-profile:declarative-v2/save-reload"],
          "performance": ["core-profile:declarative-v2/performance"]
        }
      },
      "default_column_span": 3,
      "default_row_span": 2
    }
  ]
}
